PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/attendance_db

NODE_ENV=development

# Security — replace in production
JWT_SECRET=YourSecret
JWT_ISSUER=hris-platform
JWT_AUDIENCE=hris-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=12
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MS=900000
SESSION_INACTIVITY_MS=1800000

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Bootstrap SUPER_ADMIN — must change on first login
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=superadmin@corp.io
# SEED_SUPER_ADMIN_PASSWORD=SuperAdmin2026!
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin2026!2
SEED_DEMO_DATA=false
