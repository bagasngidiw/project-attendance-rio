<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Allow direct access to the backend Express route
  RewriteCond %{REQUEST_URI} ^/backend [NC]
  RewriteRule ^ - [L]

  # Redirect all frontend single-page application routes back to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>